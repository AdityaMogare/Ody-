{
  "extends": "../../node_modules/expo/tsconfig.base.json",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-native",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@ody/shared": ["../../packages/shared/src/index.ts"],
      "@ody/types": ["../../packages/types/src/index.ts"],
      "@/design-system": ["./src/design-system/index.ts"],
      "@/design-system/*": ["./src/design-system/*"]
    }
  },
  "include": ["app/**/*.ts", "app/**/*.tsx", "src/**/*.ts", "src/**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules"]
}
