{
  "name": "@ody/api-client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "gen:contract": "orval --config orval.config.ts",
    "gen:contract:live": "orval --config orval.config.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --config ../../eslint.config.mjs src/mutator.ts src/index.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.8"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "orval": "^7.4.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
