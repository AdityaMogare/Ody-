{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".expo/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "openapi:export": {
      "cache": false,
      "outputs": ["../../openapi.json"]
    },
    "gen:contract": {
      "dependsOn": ["@ody/backend#openapi:export"],
      "cache": false,
      "outputs": ["src/generated/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^gen:contract", "gen:contract"]
    },
    "test": {
      "dependsOn": ["gen:contract"],
      "cache": false
    }
  }
}
