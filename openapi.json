{
  "openapi": "3.1.0",
  "info": {
    "title": "Ody Restaurant API",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "MenuCategory": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "sortOrder": {
            "type": "number"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "sortOrder",
          "createdAt",
          "updatedAt"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "CreateMenuCategoryBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "sortOrder": {
            "type": "number"
          }
        },
        "required": [
          "name"
        ]
      },
      "MenuItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "priceCents": {
            "type": "number"
          },
          "available": {
            "type": "boolean"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "categoryId",
          "name",
          "description",
          "priceCents",
          "available",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateMenuItemBody": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0
          },
          "available": {
            "type": "boolean"
          }
        },
        "required": [
          "categoryId",
          "name",
          "priceCents"
        ]
      },
      "UpdateMenuItemBody": {
        "type": "object",
        "properties": {
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "priceCents": {
            "type": "integer",
            "minimum": 0
          },
          "available": {
            "type": "boolean"
          }
        }
      },
      "Customer": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "phone",
          "createdAt",
          "updatedAt"
        ]
      },
      "CreateCustomerBody": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "name"
        ]
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "orderId": {
            "type": "string",
            "format": "uuid"
          },
          "menuItemId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "number"
          },
          "unitPriceCents": {
            "type": "number"
          },
          "lineTotalCents": {
            "type": "number"
          },
          "createdAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "orderId",
          "menuItemId",
          "quantity",
          "unitPriceCents",
          "lineTotalCents",
          "createdAt"
        ]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "customerId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "preparing",
              "ready",
              "completed",
              "cancelled"
            ]
          },
          "subtotalCents": {
            "type": "number"
          },
          "taxCents": {
            "type": "number"
          },
          "totalCents": {
            "type": "number"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "customerId",
          "status",
          "subtotalCents",
          "taxCents",
          "totalCents",
          "notes",
          "createdAt",
          "updatedAt"
        ]
      },
      "OrderWithItems": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Order"
          },
          {
            "type": "object",
            "properties": {
              "items": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/OrderItem"
                }
              }
            },
            "required": [
              "items"
            ]
          }
        ]
      },
      "CustomerDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Customer"
          },
          {
            "type": "object",
            "properties": {
              "orderCount": {
                "type": "integer",
                "minimum": 0
              },
              "totalSpendCents": {
                "type": "integer",
                "minimum": 0
              },
              "orders": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/OrderWithItems"
                }
              }
            },
            "required": [
              "orderCount",
              "totalSpendCents",
              "orders"
            ]
          }
        ]
      },
      "CreateOrderItemInput": {
        "type": "object",
        "properties": {
          "menuItemId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "menuItemId",
          "quantity"
        ]
      },
      "CreateOrderBody": {
        "type": "object",
        "properties": {
          "customerId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CreateOrderItemInput"
            },
            "minItems": 1
          },
          "subtotalCents": {
            "type": "integer",
            "minimum": 0
          },
          "taxCents": {
            "type": "integer",
            "minimum": 0,
            "default": 0
          },
          "totalCents": {
            "type": "integer",
            "minimum": 0
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "subtotalCents",
          "totalCents"
        ]
      },
      "UpdateOrderBody": {
        "type": "object",
        "properties": {
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "OrderActionResult": {
        "type": "object",
        "properties": {
          "order": {
            "$ref": "#/components/schemas/Order"
          },
          "previousStatus": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "accept",
              "start_preparing",
              "mark_ready",
              "complete",
              "cancel"
            ]
          },
          "allowedActions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "accept",
                "start_preparing",
                "mark_ready",
                "complete",
                "cancel"
              ]
            }
          }
        },
        "required": [
          "order",
          "previousStatus",
          "action",
          "allowedActions"
        ]
      },
      "OrderActionBody": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "accept",
              "start_preparing",
              "mark_ready",
              "complete",
              "cancel"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "OpeningHours": {
        "type": "object",
        "properties": {
          "mon": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "open": {
                "type": "string"
              },
              "close": {
                "type": "string"
              }
            },
            "required": [
              "open",
              "close"
            ]
          },
          "tue": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "open": {
                "type": "string"
              },
              "close": {
                "type": "string"
              }
            },
            "required": [
              "open",
              "close"
            ]
          },
          "wed": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "open": {
                "type": "string"
              },
              "close": {
                "type": "string"
              }
            },
            "required": [
              "open",
              "close"
            ]
          },
          "thu": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "open": {
                "type": "string"
              },
              "close": {
                "type": "string"
              }
            },
            "required": [
              "open",
              "close"
            ]
          },
          "fri": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "open": {
                "type": "string"
              },
              "close": {
                "type": "string"
              }
            },
            "required": [
              "open",
              "close"
            ]
          },
          "sat": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "open": {
                "type": "string"
              },
              "close": {
                "type": "string"
              }
            },
            "required": [
              "open",
              "close"
            ]
          },
          "sun": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "open": {
                "type": "string"
              },
              "close": {
                "type": "string"
              }
            },
            "required": [
              "open",
              "close"
            ]
          }
        },
        "required": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri",
          "sat",
          "sun"
        ]
      },
      "RestaurantSettings": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "prepTimeMinutes": {
            "type": "integer"
          },
          "autoAcceptOrders": {
            "type": "boolean"
          },
          "serviceAvailable": {
            "type": "boolean"
          },
          "openingHours": {
            "$ref": "#/components/schemas/OpeningHours"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "prepTimeMinutes",
          "autoAcceptOrders",
          "serviceAvailable",
          "openingHours",
          "updatedAt"
        ]
      },
      "UpdateSettingsBody": {
        "type": "object",
        "properties": {
          "prepTimeMinutes": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "autoAcceptOrders": {
            "type": "boolean"
          },
          "serviceAvailable": {
            "type": "boolean"
          },
          "openingHours": {
            "$ref": "#/components/schemas/OpeningHours"
          }
        }
      }
    },
    "parameters": {}
  },
  "paths": {
    "/menu/categories": {
      "get": {
        "tags": [
          "Menu"
        ],
        "responses": {
          "200": {
            "description": "List menu categories",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MenuCategory"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Menu"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMenuCategoryBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Category created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuCategory"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/menu/items": {
      "get": {
        "tags": [
          "Menu"
        ],
        "responses": {
          "200": {
            "description": "List menu items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/MenuItem"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Menu"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMenuItemBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Menu item created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItem"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/menu/items/{id}": {
      "patch": {
        "tags": [
          "Menu"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateMenuItemBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Menu item updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MenuItem"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Menu"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Menu item deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "deleted": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "id": {
                      "type": "string",
                      "format": "uuid"
                    }
                  },
                  "required": [
                    "deleted",
                    "id"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Item referenced by orders",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/customers": {
      "get": {
        "tags": [
          "Customers"
        ],
        "responses": {
          "200": {
            "description": "List customers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Customer"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Customers"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCustomerBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Customer created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Customer"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/customers/{id}": {
      "get": {
        "tags": [
          "Customers"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Customer with order history and spend",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "get": {
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "accepted",
                "preparing",
                "ready",
                "completed",
                "cancelled"
              ]
            },
            "required": false,
            "name": "status",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "customerId",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0,
              "default": 0
            },
            "required": false,
            "name": "offset",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "List orders with line items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/OrderWithItems"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Orders"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateOrderBody"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Order created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderWithItems"
                }
              }
            }
          },
          "400": {
            "description": "Invalid order payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{id}": {
      "get": {
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Order detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderWithItems"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "Orders"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateOrderBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Order updated (notes only — status via actions)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrderWithItems"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{id}/actions": {
      "post": {
        "tags": [
          "Orders"
        ],
